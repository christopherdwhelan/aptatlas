    given-names: K.
version: "4.0"
date-released: 2026-09-07
license: MIT
url: "https://aptatlas.org"
repository-code: "https://github.com/christopherdwhelan/aptatlas"
keywords:
  - proteomics
  - high-plex proteomics
  - platform comparison
  - biomarker discovery
  - reproducibility
