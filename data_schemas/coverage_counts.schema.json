{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aptatlas.org/data/coverage_counts.schema.json",
  "title": "Coverage counts",
  "description": "Distinct-protein counts computed from the protein catalogue.",
  "type": "object",
  "required": [
    "schema",
    "name",
    "title",
    "version",
    "last_updated",
    "licence",
    "licence_url",
    "citation",
    "archive_doi",
    "third_party",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "description": "URL of this schema for this release"
    },
    "name": {
      "const": "coverage_counts"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "APT release"
    },
    "last_updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "licence": {
      "const": "CC-BY-4.0"
    },
    "licence_url": {
      "type": "string"
    },
    "citation": {
      "type": "string"
    },
    "archive_doi": {
      "type": "string"
    },
    "third_party": {
      "type": "array",
      "description": "Sources this file draws on that carry their own licence.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "licence",
          "url",
          "relationship",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "licence": {
            "type": "string",
            "description": "SPDX identifier"
          },
          "url": {
            "type": "string"
          },
          "relationship": {
            "enum": [
              "source",
              "derived"
            ]
          },
          "note": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "JSONPath, relative to data, of fields derived from this source"
          },
          "fields_derived_in_part": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "JSONPath, relative to data, of fields computed partly from the fields above"
          }
        }
      }
    },
    "data": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "integer"
        },
        "unmappedEntries": {
          "type": "integer"
        },
        "proteins": {
          "type": "integer"
        },
        "perPlatform": {
          "type": "object",
          "properties": {
            "seer-proteograph": {
              "type": "integer"
            },
            "illumina-protein-prep": {
              "type": "integer"
            },
            "olink-explore-ht": {
              "type": "integer"
            },
            "biognosys-truediscovery": {
              "type": "integer"
            },
            "nomic-omni": {
              "type": "integer"
            },
            "nulisa": {
              "type": "integer"
            }
          },
          "required": [
            "seer-proteograph",
            "illumina-protein-prep",
            "olink-explore-ht",
            "biognosys-truediscovery",
            "nomic-omni",
            "nulisa"
          ],
          "additionalProperties": false
        },
        "onOnePlatform": {
          "type": "integer"
        },
        "onAllPlatforms": {
          "type": "integer"
        }
      },
      "required": [
        "entries",
        "unmappedEntries",
        "proteins",
        "perPlatform",
        "onOnePlatform",
        "onAllPlatforms"
      ],
      "additionalProperties": false
    }
  }
}
