{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aptatlas.org/data/platforms.schema.json",
  "title": "Assessed platforms",
  "description": "The six assessed platforms.",
  "type": "object",
  "required": [
    "schema",
    "name",
    "title",
    "version",
    "last_updated",
    "licence",
    "licence_url",
    "citation",
    "archive_doi",
    "third_party",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "description": "URL of this schema for this release"
    },
    "name": {
      "const": "platforms"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "APT release"
    },
    "last_updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "licence": {
      "const": "CC-BY-4.0"
    },
    "licence_url": {
      "type": "string"
    },
    "citation": {
      "type": "string"
    },
    "archive_doi": {
      "type": "string"
    },
    "third_party": {
      "type": "array",
      "description": "Sources this file draws on that carry their own licence.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "licence",
          "url",
          "relationship",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "licence": {
            "type": "string",
            "description": "SPDX identifier"
          },
          "url": {
            "type": "string"
          },
          "relationship": {
            "enum": [
              "source",
              "derived"
            ]
          },
          "note": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "JSONPath, relative to data, of fields derived from this source"
          },
          "fields_derived_in_part": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "JSONPath, relative to data, of fields computed partly from the fields above"
          }
        }
      }
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "olink-explore-ht",
              "illumina-protein-prep",
              "nulisa",
              "nomic-omni",
              "seer-proteograph",
              "biognosys-truediscovery"
            ]
          },
          "name": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "technology": {
            "type": "string"
          },
          "readoutInstruments": {
            "type": "string"
          },
          "proteins": {
            "type": "string"
          },
          "proteinsNumeric": {
            "type": "integer"
          },
          "sampleInput": {
            "type": "string"
          },
          "sampleTypes": {
            "type": "string"
          },
          "quantification": {
            "type": "string"
          },
          "precision": {
            "type": "string"
          },
          "throughput": {
            "type": "string"
          },
          "costRange": {
            "type": "string"
          },
          "costRangeNumeric": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "keyStrengths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "keyLimitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidenceDepth": {
            "type": "string"
          },
          "platformType": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "textColor": {
            "type": "string"
          },
          "overview": {
            "type": "string"
          },
          "bestFor": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "considerInstead": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "platform": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "platform",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "historicalNames": {
            "type": [
              "null",
              "string"
            ]
          },
          "ptmCapable": {
            "type": "boolean"
          },
          "previousNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          },
          "sensitivity": {
            "type": "string"
          },
          "specificity": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "company",
          "technology",
          "proteins",
          "proteinsNumeric",
          "sampleInput",
          "sampleTypes",
          "quantification",
          "costRange",
          "costRangeNumeric",
          "keyStrengths",
          "keyLimitations",
          "evidenceDepth",
          "platformType",
          "color",
          "textColor",
          "overview",
          "bestFor",
          "considerInstead",
          "historicalNames",
          "ptmCapable"
        ],
        "additionalProperties": false
      }
    }
  }
}
