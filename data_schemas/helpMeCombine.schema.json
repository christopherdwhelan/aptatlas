                  }
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "non_dominated",
                "total",
                "dominated",
                "note"
              ],
              "additionalProperties": false
            },
            "quality_score_robustness": {
              "type": "object",
              "properties": {
