{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aptatlas.org/data/evidence.csv.schema.json",
  "title": "Evidence base, flat",
  "description": "Schema for one row of evidence.csv. UTF-8, comma-separated, with a header row. Multiple values in a cell are separated by a semicolon and a space.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "type": "string",
      "description": "Claim id"
    },
    "study_id": {
      "type": "string",
      "description": "Study id"
    },
    "study": {
      "type": "string",
      "description": "Short citation"
    },
    "doi": {
      "type": "string",
      "pattern": "^10\\."
    },
    "claim": {
      "type": "string",
      "description": "The claim as shown on the Evidence Base page"
    },
    "figures": {
      "type": "string",
      "description": "Numbers the claim states, each as value (what it describes)"
    },
    "source_location": {
      "type": "string",
      "description": "Where in the paper, at section level"
    },
    "source_version": {
      "enum": [
        "published",
        "preprint",
        "unverified"
      ]
    },
    "platforms": {
      "type": "string",
      "description": "Platform ids"
    },
    "topics": {
      "type": "string",
      "description": "Topics"
    },
    "vendor_authorship": {
      "type": "string",
      "description": "Vendor authorship, empty if none"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "last_updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "licence": {
      "const": "CC-BY-4.0"
    }
  },
  "required": [
    "claim_id",
    "study_id",
    "study",
    "doi",
    "claim",
    "figures",
    "source_location",
    "source_version",
    "platforms",
    "topics",
    "vendor_authorship",
    "version",
    "last_updated",
    "licence"
  ]
}
