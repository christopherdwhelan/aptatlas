{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aptatlas.org/data/all_platforms.schema.json",
  "title": "Platform catalogue",
  "description": "The full platform catalogue with evaluation levels.",
  "type": "object",
  "required": [
    "schema",
    "name",
    "title",
    "version",
    "last_updated",
    "licence",
    "licence_url",
    "citation",
    "archive_doi",
    "third_party",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "description": "URL of this schema for this release"
    },
    "name": {
      "const": "all_platforms"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "APT release"
    },
    "last_updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "licence": {
      "const": "CC-BY-4.0"
    },
    "licence_url": {
      "type": "string"
    },
    "citation": {
      "type": "string"
    },
    "archive_doi": {
      "type": "string"
    },
    "third_party": {
      "type": "array",
      "description": "Sources this file draws on that carry their own licence.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "licence",
          "url",
          "relationship",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "licence": {
            "type": "string",
            "description": "SPDX identifier"
          },
          "url": {
            "type": "string"
          },
          "relationship": {
            "enum": [
              "source",
              "derived"
            ]
          },
          "note": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "JSONPath, relative to data, of fields derived from this source"
          },
          "fields_derived_in_part": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "JSONPath, relative to data, of fields computed partly from the fields above"
          }
        }
      }
    },
    "data": {
      "type": "object",
      "properties": {
        "meta": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "scope": {
              "type": "string"
            },
            "n_total": {
              "type": "integer"
            },
            "n_ranked_services": {
              "type": "integer"
            },
            "n_emerging": {
              "type": "integer"
            },
            "n_deployable": {
              "type": "integer"
            },
            "evaluation_levels": {
              "type": "object",
              "properties": {
                "1_deep_score": {
                  "type": "string"
                },
                "2_integration_readiness": {
                  "type": "string"
                },
                "3_emerging_not_scored": {
                  "type": "string"
                }
              },
              "required": [
                "1_deep_score",
                "2_integration_readiness",
                "3_emerging_not_scored"
              ],
              "additionalProperties": false
            },
            "ranking_axis": {
              "type": "string"
            },
            "tiers": {
              "type": "object",
              "properties": {
                "T1": {
                  "type": "string"
                },
                "T2": {
                  "type": "string"
                },
                "T3": {
                  "type": "string"
                }
              },
              "required": [
                "T1",
                "T2",
                "T3"
              ],
              "additionalProperties": false
            },
            "availability_note": {
              "type": "string"
            },
            "excluded_adjacent": {
              "type": "string"
            },
            "independence_gate": {
              "type": "string"
            },
            "verification": {
              "type": "string"
            },
            "score_status_note": {
              "type": "string"
            },
            "n_targeted": {
              "type": "integer"
            },
            "overview_note": {
              "type": "string"
            },
            "n_preliminary": {
              "type": "integer"
            },
            "n_apt_assessed": {
              "type": "integer"
            },
            "n_enabling": {
              "type": "integer"
            },
            "n_retired": {
              "type": "integer"
            }
          },
          "required": [
            "title",
            "scope",
            "n_total",
            "n_ranked_services",
            "n_emerging",
            "n_deployable",
            "evaluation_levels",
            "ranking_axis",
            "tiers",
            "availability_note",
            "excluded_adjacent",
            "independence_gate",
            "verification",
            "score_status_note",
            "n_targeted",
            "overview_note",
            "n_preliminary",
            "n_apt_assessed",
            "n_enabling",
            "n_retired"
          ],
          "additionalProperties": false
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rank": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "platform": {
                "type": "string"
              },
              "technology_group": {
                "type": "string"
              },
              "vendor": {
                "type": "string"
              },
              "integration_tier": {
                "type": "string"
              },
              "integration_status": {
                "type": "string"
              },
              "apt_integrated": {
                "type": "boolean"
              },
              "maturity_score": {
                "type": "integer"
              },
              "validation_score": {
                "type": "number"
              },
              "apt_readiness_rank_v1": {
                "type": [
                  "null",
                  "number"
                ]
              },
              "availability_status": {
                "type": "string"
              },
              "currently_deployable": {
                "type": "boolean"
              },
              "replaced_by": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "source": {
                "type": "string"
              },
              "key_citation": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "availability_source": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "notes": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "entity_type": {
                "type": "string"
              },
              "runs_on": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "ranked": {
                "type": "boolean"
              },
              "tier_num": {
                "type": "integer"
              },
              "scoreable": {
                "type": "boolean"
              },
              "readiness_precise": {
                "type": [
                  "null",
                  "number"
                ]
              },
              "validation_basis": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "score_status": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "detail": {
                "type": "object",
                "properties": {
                  "chemistry": {
                    "type": "string"
                  },
                  "plex_or_depth": {
                    "type": "string"
                  },
                  "matrix": {
                    "type": "string"
                  },
                  "quantitation_type": {
                    "type": "string"
                  },
                  "key_citation_short": {
                    "type": "string"
                  },
                  "commercial_status_note": {
                    "type": "string"
                  },
                  "notes": {
                    "type": "string"
                  },
                  "cost_tier": {
                    "type": "string"
                  },
                  "overview": {
                    "type": "object",
                    "properties": {
                      "about": {
                        "type": "string"
                      },
                      "best_for": {
                        "type": "string"
                      },
                      "strengths": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "limitations": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "about",
                      "best_for",
                      "strengths",
                      "limitations"
                    ],
                    "additionalProperties": false
                  },
                  "publications": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "doi": {
                          "type": [
                            "null",
                            "string"
                          ]
                        }
                      },
                      "required": [
                        "label",
                        "doi"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "sample_volume": {
                    "type": [
                      "null",
                      "string"
                    ]
                  },
                  "throughput": {
                    "type": "string"
                  },
                  "proteoform_ptm": {
                    "type": "string"
                  },
                  "csf_performance": {
                    "type": "string"
                  },
                  "analytical_validation": {
                    "type": "string"
                  },
                  "key_citation_doi": {
                    "type": [
                      "null",
                      "string"
                    ]
                  },
                  "availability_note": {
                    "type": "string"
                  },
                  "assessment_scope_note": {
                    "type": "string"
                  },
                  "coverage_evidence_note": {
                    "type": "string"
                  }
                },
                "required": [
                  "overview"
                ],
                "additionalProperties": false
              },
              "verification_grade": {
                "type": "string"
              },
              "verification_source_tier": {
                "type": "string"
              },
              "sub100_confirmed": {
                "type": "boolean"
              },
              "readiness_note": {
                "type": "string"
              },
              "combined_with": {
                "type": "string"
              }
            },
            "required": [
              "rank",
              "platform",
              "technology_group",
              "vendor",
              "integration_tier",
              "integration_status",
              "apt_integrated",
              "maturity_score",
              "validation_score",
              "apt_readiness_rank_v1",
              "availability_status",
              "currently_deployable",
              "replaced_by",
              "source",
              "key_citation",
              "availability_source",
              "notes",
              "entity_type",
              "runs_on",
              "ranked",
              "tier_num",
              "scoreable",
              "readiness_precise",
              "validation_basis",
              "score_status",
              "detail",
              "sub100_confirmed"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "meta",
        "platforms"
      ],
      "additionalProperties": false
    }
  }
}
